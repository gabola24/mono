# Required
OPENAI_API_KEY=your-openai-api-key-here

# Database — local dev: docker-compose up -d postgres then alembic upgrade head
DATABASE_URL=postgresql+asyncpg://zukuri:zukuri@localhost:5432/zukuri

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# OpenAI model routing (all default to gpt-4o-mini — override per purpose)
# CHAT_MODEL=gpt-4o-mini
# DISCOVERY_MODEL=gpt-4o-mini
# EDGE_REASON_MODEL=gpt-4o-mini
# PLAN_MODEL=gpt-4o-mini
# DNA_MODEL=gpt-4o-mini
# VISION_MODEL=gpt-4o-mini
# IMAGE_MODEL=dall-e-3

# Daily OpenAI spend cap in USD across all users (0 = no cap)
OPENAI_DAILY_BUDGET_USD=5.0

# Clerk auth — leave empty to run in single-tenant dev mode
# Get these from https://dashboard.clerk.com → your app → API Keys
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_...
CLERK_SECRET_KEY=sk_live_...

# Stripe billing — leave empty to disable billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Frontend URL for Stripe checkout redirect
APP_URL=http://localhost:5173

# Sentry error tracking — leave empty to disable
SENTRY_DSN=https://...@o0.ingest.sentry.io/...
